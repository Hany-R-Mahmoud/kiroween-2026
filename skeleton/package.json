{
  "name": "@kiroween/skeleton",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared horror lore engine: content packs, seeded RNG, puzzle generator, hints, theme packs, auth and progress.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./design/tokens.css": "./src/design/tokens.css",
    "./design/mood.css": "./src/design/mood.css",
    "./design/ui.css": "./src/design/ui.css",
    "./mood": "./src/design/Mood.tsx",
    "./book": "./src/book/index.ts",
    "./book/book.css": "./src/book/book.css",
    "./shell": "./src/shell/index.ts",
    "./shell/holo-card.css": "./src/shell/holoCard.css"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:content": "tsx scripts/audit.ts",
    "db:import": "tsx scripts/import.ts",
    "db:import-keepers-note": "tsx scripts/import-keepers-note.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check-models": "tsx scripts/check-models.ts",
    "db:check-reader": "tsx scripts/check-reader-role.ts",
    "db:set-atlas-web-password": "tsx scripts/set-atlas-web-password.ts"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.3",
    "react": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "react": "19.3.1"
  }
}
