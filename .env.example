# Neon Postgres connection string (pooled): app runtime
DATABASE_URL=
# Neon Postgres connection string (direct, unpooled): migrations and content import
DATABASE_URL_UNPOOLED=

# Neon Auth
# Auth URL from the Neon console (https). The server toolkit derives the JWKS address from it.
NEON_AUTH_BASE_URL=
# At least 32 random characters. Signs the session cache cookie: anyone who has it can forge a session.
NEON_AUTH_COOKIE_SECRET=
# From the Neon console. Not read by the code yet (kept for a later cross-domain JWT check).
NEON_AUTH_JWKS_URL=

# Game app
# Legend id a guest may enter besides the tutorial. Empty means banshee.
GUEST_WORLD=
# true shows the Arabic direction (rtl). Empty or false means English only.
FEATURE_ARABIC=
