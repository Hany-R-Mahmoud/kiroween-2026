# Neon Postgres connection string (pooled): app runtime
DATABASE_URL=
# Neon Postgres connection string (direct, unpooled): migrations and content import
DATABASE_URL_UNPOOLED=

# Neon Auth
# Auth URL from the Neon console (https). The server toolkit derives the JWKS address from it.
NEON_AUTH_BASE_URL=
# At least 32 random characters. Signs the session cache cookie: anyone who has it can forge a session.
NEON_AUTH_COOKIE_SECRET=
# From the Neon console. Not read by the code yet (kept for a later cross-domain JWT check).
NEON_AUTH_JWKS_URL=

# Game app
# Legend id a guest may enter besides the tutorial. Empty means banshee.
GUEST_WORLD=
# true shows the Arabic direction (rtl). Empty or false means English only. Used by the game and the atlas.
FEATURE_ARABIC=
# Optional: put in front of the hall's atlas links. Empty on the shared domain; http://localhost:3001 locally.
ATLAS_ORIGIN=
# Optional, public URL (not a secret): image CDN endpoint, e.g. https://ik.imagekit.io/<id>. Empty means images come from /media/. Used by the game and the atlas.
IMAGE_CDN_URL=

# Atlas
# Pooled connection string of the read-only atlas_web role on the dev branch (SELECT only; see docs/tech-decisions.md).
ATLAS_DATABASE_URL=
# Optional: an https origin (or http://localhost) for absolute Open Graph URLs. Empty means no og:image or og:url.
PUBLIC_ORIGIN=
# Game: AES-256-GCM key for run tokens. Base64 of 32 random bytes (for example: openssl rand -base64 32). Server only; never commit a value.
GAME_TOKEN_KEY=
